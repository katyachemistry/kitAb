# Copy to fastab.local.env (install.sh writes fastab.local.env in the repo root).
# Source before running pipelines (from repo root):
#   source fastab.local.env

FASTAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export FASTAB_ENV=fastab
export FASTAB_ENV_ABB2=abb2
export FASTAB_ENV_ABB3=abb3

# Descriptor pipeline (get_descriptors.sh, automl)
export DSSP_BIN=mkdssp
export PY="conda run -n ${FASTAB_ENV} python"

# ABB3 prediction (predict_structure.sh)
export ABB3_SRC="${FASTAB_ROOT}/vendor/abodybuilder3/src"
export ABB3_CHECKPOINT="${FASTAB_ROOT}/vendor/abodybuilder3/output/plddt-loss/best_second_stage.ckpt"
export ABB3_DEVICE=cuda:0
export ABB3_BATCH_SIZE=4
export PYTHON="conda run -n ${FASTAB_ENV_ABB3} python"

# ABB2 prediction + IMGT renumber + minimization
export ABB2_DEVICE=cuda:0
export ABB2_BATCH_SIZE=4
export ABB2_PYTHON="conda run -n ${FASTAB_ENV_ABB2} python"
